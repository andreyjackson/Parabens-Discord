# Token do bot (Developer Portal > Bot > Token)
DISCORD_TOKEN=seu_token_aqui

# Application ID (Developer Portal > General Information > Application ID)
# Necessário para gerar o link de convite via /convite
APPLICATION_ID=

# ID do servidor de desenvolvimento (opcional — acelera sync dos slash commands)
GUILD_ID=

# Boas-vindas automáticas (requer Server Members Intent no Developer Portal)
ENABLE_WELCOME=false

# URLs públicas (recomendado para verificação do bot no Discord em escala)
PRIVACY_URL=
SUPPORT_URL=
